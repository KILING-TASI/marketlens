include pyproject.toml setup.py _build_skill.py README.md SKILL.md LICENSE THIRD_PARTY_NOTICES.md
recursive-include agents *.py *.js *.cjs *.mjs *.md *.json *.txt *.csv *.html *.css *.yaml *.yml *.jpg *.png *.svg
recursive-include references *.py *.js *.cjs *.mjs *.md *.json *.txt *.csv *.html *.css *.yaml *.yml *.jpg *.png *.svg
recursive-include scripts *.py *.js *.cjs *.mjs *.md *.json *.txt *.csv *.html *.css *.yaml *.yml *.jpg *.png *.svg
recursive-include docs *.py *.js *.cjs *.mjs *.md *.json *.txt *.csv *.html *.css *.yaml *.yml *.jpg *.png *.svg
recursive-include scripts/marketlens *.py
global-exclude *.pyc *.pdf *.docx *.xlsx
prune build
prune dist

include try_demo.py Start-Demo.cmd Start-Demo.sh BEGINNER.md
include examples/teaching-report.html examples/teaching-report.jpg examples/teaching-report-note.md

include EXPANSION.md
recursive-include examples/expansion-teaching *.json


include AUDIT_SCOPE.md

include README.en.md CHANGELOG.md

include CONTRIBUTING.md SECURITY.md LIFECYCLE.md

global-exclude *.xls

include RIGHTS_INDEX.json

include SHARED_CODE.json
recursive-include tools *.py

include USAGE.md
